# ===== Servidor =====
PORT=3000
NODE_ENV=development

# ===== Banco de dados (PostgreSQL) =====
# Exemplo local: postgres://usuario:senha@localhost:5432/controle_estoque
# Exemplo gratuito (Supabase/Neon): a URL que o serviço te der. Na Fase 2 eu
# te guio para criar um banco grátis e preencher aqui.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/controle_estoque

# ===== Autenticação (JWT) =====
JWT_SECRET=troque-por-um-segredo-longo
JWT_EXPIRES_IN=7d

# ===== WhatsApp Business Cloud API (Regra 5 e 6) =====
WHATSAPP_TOKEN=coloque-aqui-o-token-de-acesso-da-sua-app
WHATSAPP_PHONE_ID=coloque-aqui-o-id-numerico-do-seu-numero
WHATSAPP_VERIFY_TOKEN=defina-um-token-para-verificacao-do-webhook

# ===== URLs permitidas (CORS) =====
WEB_URL=http://localhost:5173