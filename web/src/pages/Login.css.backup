/* pages/Login.css */

/* --- TEMA PADRÃO (HERDADO DE theme.css) --- */
/* A paleta de cores e fontes é definida em theme.css */

/* --- LAYOUT GERAL DA TELA --- */
.login-container {
  display: flex;
  min-height: 100vh; /* Ocupa toda a altura da viewport */
  overflow: hidden; /* Para evitar barras de rolagem desnecessárias */
}

/* --- PAINEL ESQUERDO: APRESENTAÇÃO DA EMPRESA (INTEGRADO AO FUNDO) --- */
.presentation-panel {
  flex: 1; /* Ocupa espaço disponível */
  display: flex;
  justify-content: center;
  align-items: center;
  padding: 4rem 2rem; /* Espaçamento interno generoso */
  background: linear-gradient(135deg, var(--accent, #06b6d4) 0%, #8b5cf6 100%); /* Gradiente sofisticado */
  color: #fff; /* Texto branco sobre gradiente */
  position: relative; /* Para posicionar os elementos de fundo */
  overflow: hidden; /* Garante que os elementos de fundo não saiam da área */
}

.presentation-content {
  text-align: center;
  z-index: 1; /* Garante que o conteúdo fique acima dos elementos de fundo */
  max-width: 550px; /* Limita a largura do texto para melhor legibilidade */
  padding: 2rem; /* Espaçamento interno */
}

.logo-placeholder {
  margin-bottom: 1rem;
  display: inline-block; /* Necessário para o background */
  /* Estilos para o logo virão do Logo.jsx */
}

.company-name {
  font-size: 1.8rem;
  font-weight: 700;
  margin-bottom: 0.5rem;
  letter-spacing: -0.5px; /* Ajuste fino na espessura */
}

.main-title {
  font-size: 2.5rem; /* Título grande, elegante e impactante */
  font-weight: 700;
  line-height: 1.2; /* Espaçamento entre linhas para legibilidade */
  margin-bottom: 1rem;
  letter-spacing: -1px;
}

.description {
  font-size: 1.1rem;
  color: rgba(255, 255, 255, 0.9); /* Quase branco, ligeiramente translúcido */
  margin-bottom: 0.75rem;
  line-height: 1.6;
}

.highlight-phrase {
  font-size: 1.3rem;
  font-weight: 600;
  color: rgba(255, 255, 255, 0.95);
  margin-top: 1rem;
  line-height: 1.3;
}

/* --- Elementos geométricos abstratos de fundo --- */
.presentation-panel::before,
.presentation-panel::after {
  content: '';
  position: absolute;
  background: rgba(255, 255, 255, 0.05); /* Baixa opacidade */
  border-radius: 50%;
  filter: blur(80px); /* Efeito de desfoque para suavidade */
  z-index: 0; /* Fica atrás do conteúdo */
}
.presentation-panel::before {
  width: 200px; height: 200px;
  top: 10%; left: 20%;
}
.presentation-panel::after {
  width: 250px; height: 250px;
  bottom: 15%; right: 15%;
}

/* --- LADO DIREITO: PAINEL DE LOGIN (CARD CENTRALIZADO) --- */
.right-panel {
  flex: 1;
  display: flex;
  justify-content: center;
  align-items: center;
  background-color: var(--bg-primary); /* Fundo mais neutro */
  padding: 2rem;
  width: 100%;
}

.login-card {
  background: var(--bg-card);
  border: 1px solid var(--border);
  border-radius: var(--radius-lg); /* Cantos arredondados */
  padding: 2.5rem;
  width: 100%;
  max-width: 420px; /* Largura definida */
  box-shadow: var(--shadow); /* Sombra suave */
  display: flex;
  flex-direction: column;
  gap: 1rem; /* Espaçamento entre elementos internos */
}

.login-header {
  text-align: center;
  margin-bottom: 1.5rem;
}

.login-header h1 {
  font-size: 1.8rem;
  font-weight: 700;
  margin-bottom: 0.5rem;
  color: var(--text-primary);
}

.login-header p {
  font-size: 1rem;
  color: var(--text-muted);
}

.login-form {
  display: flex;
  flex-direction: column;
  gap: 1rem;
}

.form-group label {
  display: block;
  font-size: 0.85rem;
  color: var(--text-secondary);
  margin-bottom: 0.3rem;
}

.form-group input {
  background: var(--bg-input);
  border: 1px solid var(--border);
  border-radius: var(--radius);
  padding: 0.8rem 1rem;
  color: var(--text-primary);
  font-size: 0.95rem;
  transition: border-color 0.2s;
  width: 100%;
}

.form-group input:focus {
  outline: none;
  border-color: var(--accent);
}

.password-wrapper {
  position: relative;
}

.password-wrapper input {
  padding-right: 2.8rem; /* Espaço para o botão do olho */
}

.btn-eye {
  position: absolute;
  right: 0.75rem;
  top: 50%;
  transform: translateY(-50%);
  background: transparent;
  border: none;
  cursor: pointer;
  font-size: 1.1rem;
  color: var(--text-secondary);
  padding: 0.2rem;
  transition: color 0.2s;
}

.btn-eye:hover {
  color: var(--accent);
}

.forgot-password {
  margin-top: 0.4rem;
  text-align: right;
  font-size: 0.8rem;
}

.forgot-password a {
  color: var(--text-secondary);
  text-decoration: none;
  transition: color 0.2s;
}

.forgot-password a:hover {
  color: var(--accent);
}

.login-error {
  color: var(--danger);
  font-size: 0.85rem;
  text-align: center;
  margin-top: -0.5rem;
  margin-bottom: 0.5rem;
}

.btn-primary {
  background: var(--accent);
  color: var(--accent-text);
  border: none;
  padding: 0.9rem;
  border-radius: var(--radius);
  font-size: 1.05rem;
  font-weight: 700;
  cursor: pointer;
  transition: background 0.2s, transform 0.2s;
}

.btn-primary:hover {
  background: var(--accent-hover);
}

.btn-primary:disabled {
  opacity: 0.6;
  cursor: not-allowed;
}

.login-divider {
  text-align: center;
  margin: 1.5rem 0;
  position: relative;
}

.login-divider::before,
.login-divider::after {
  content: '';
  position: absolute;
  top: 50%;
  width: 40%;
  height: 1px;
  background: var(--border);
  transform: translateY(-50%);
}

.login-divider::before { left: 0; }
.login-divider::after { right: 0; }

.login-divider span {
  background: var(--bg-primary); /* Fundo da tela */
  padding: 0 0.75rem;
  color: var(--text-muted);
  font-size: 0.85rem;
  position: relative;
  z-index: 1;
}

.btn-demo {
  width: 100%;
  background: var(--bg-input);
  color: var(--accent);
  border: 1px dashed var(--accent);
  padding: 0.9rem;
  border-radius: var(--radius);
  font-size: 1.05rem;
  font-weight: 700;
  cursor: pointer;
  transition: all 0.2s;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 0.5rem;
}

.btn-demo:hover {
  background: var(--accent-dim);
  border-style: solid;
}

.btn-demo:disabled {
  opacity: 0.6;
  cursor: not-allowed;
}

.demo-description {
  margin-top: 0.75rem;
  font-size: 0.8rem;
  color: var(--text-muted);
  text-align: center;
  line-height: 1.4;
}

.create-account {
  margin-top: 1.5rem;
  text-align: center;
  font-size: 0.9rem;
  color: var(--text-secondary);
}

.create-account a {
  color: var(--accent);
  font-weight: 600;
  text-decoration: none;
  transition: color 0.2s;
}

.create-account a:hover {
  color: var(--accent-hover);
  text-decoration: underline;
}

/* Responsividade */
@media (max-width: 1024px) { /* Tablets e menores */
  .login-container {
    flex-direction: column;
  }
  .left-panel { /* Renomeado de presentation-panel para left-panel */
    display: flex; /* Mostra o painel em telas médias */
    height: 40vh; /* Altura fixa para apresentação */
    padding: 2rem 1rem;
    justify-content: center;
    align-items: center;
    text-align: center;
  }
  .company-name, .main-title, .description, .highlight-phrase {
    display: none; /* Esconde textos também */
  }

  .right-panel {
    height: 60vh; /* Login ocupa o restante */
    padding: 2rem 1rem;
    justify-content: flex-start; /* Centraliza no topo para não ficar colado embaixo */
  }
  .login-card {
    max-width: 380px;
    padding: 2rem;
    margin-top: 1rem; /* Adiciona espaço acima do card quando ele não está centralizado verticalmente */
  }
}

@media (max-width: 768px) { /* Celulares */
  .left-panel {
    display: none; /* Oculta completamente em telas pequenas */
  }
  .right-panel {
    flex: 1;
    width: 100%;
    justify-content: flex-start; /* Centraliza no topo */
    padding: 3rem 1rem;
  }
  .login-card {
    max-width: 100%;
    border-radius: 0; /* Sem bordas arredondadas em tela cheia */
    border: none;
    box-shadow: none;
    height: 100%;
    justify-content: center; /* Centraliza verticalmente no espaço restante */
  }
  .login-header, .login-form, .login-divider, .btn-demo, .demo-description, .create-account {
    margin-bottom: 1.5rem; /* Espaçamento maior entre elementos */
  }
  .login-header h1 { font-size: 1.6rem; }
  .login-subtitle { font-size: 0.9rem; }
  .btn-primary, .btn-demo { padding: 0.9rem; font-size: 1rem; }
  .form-group input { padding: 0.8rem 1rem; font-size: 0.95rem; }
  .btn-eye { font-size: 1.1rem; }
}

/* Ajustes finais para garantir centralização e alinhamento */
.login-container { align-items: stretch; }
.presentation-panel { justify-content: center; align-items: center; }
.right-panel { justify-content: center; align-items: center; }
.login-card { margin: auto; } /* Centraliza o card caso não ocupe toda a tela */